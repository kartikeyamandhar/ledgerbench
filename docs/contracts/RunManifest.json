{
  "$defs": {
    "RunTotals": {
      "additionalProperties": false,
      "description": "Run-level accounting: size, spend, and latency.",
      "properties": {
        "cost_usd": {
          "minimum": 0.0,
          "title": "Cost Usd",
          "type": "number"
        },
        "items": {
          "minimum": 0,
          "title": "Items",
          "type": "integer"
        },
        "latency_p50_ms": {
          "minimum": 0.0,
          "title": "Latency P50 Ms",
          "type": "number"
        },
        "latency_p95_ms": {
          "minimum": 0.0,
          "title": "Latency P95 Ms",
          "type": "number"
        }
      },
      "required": [
        "items",
        "cost_usd",
        "latency_p50_ms",
        "latency_p95_ms"
      ],
      "title": "RunTotals",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Everything needed to attribute, audit, and re-score one run.",
  "properties": {
    "agent_id": {
      "minLength": 1,
      "title": "Agent Id",
      "type": "string"
    },
    "condition": {
      "enum": [
        "closed",
        "open"
      ],
      "title": "Condition",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "git_commit": {
      "minLength": 1,
      "title": "Git Commit",
      "type": "string"
    },
    "model_snapshot_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Snapshot Id"
    },
    "repetitions": {
      "minimum": 1,
      "title": "Repetitions",
      "type": "integer"
    },
    "seeds": {
      "items": {
        "type": "integer"
      },
      "minItems": 1,
      "title": "Seeds",
      "type": "array"
    },
    "suite_hash": {
      "minLength": 1,
      "title": "Suite Hash",
      "type": "string"
    },
    "suite_version": {
      "minLength": 1,
      "title": "Suite Version",
      "type": "string"
    },
    "tool_version": {
      "minLength": 1,
      "title": "Tool Version",
      "type": "string"
    },
    "totals": {
      "$ref": "#/$defs/RunTotals"
    },
    "world_hashes": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "World Hashes",
      "type": "object"
    }
  },
  "required": [
    "tool_version",
    "suite_version",
    "suite_hash",
    "world_hashes",
    "agent_id",
    "condition",
    "seeds",
    "repetitions",
    "totals",
    "git_commit",
    "created_at"
  ],
  "title": "RunManifest",
  "type": "object"
}
