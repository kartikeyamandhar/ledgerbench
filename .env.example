# Copy to .env (gitignored) and fill in real values. The CLI loads .env explicitly.
# Placeholders only -- never commit real secrets. The gitleaks hook blocks them.

# Provider API keys (only needed for the live adapters, not the demo).
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# BYO mode: a READ-ONLY warehouse connection. Use a read-only role.
LEDGERBENCH_WAREHOUSE_URL=duckdb:////absolute/path/to/warehouse.duckdb
