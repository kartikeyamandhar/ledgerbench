   "config": {
    "meta": {
     "ledgerbench": {
      "metrics": [
       {
        "description": "Net revenue from completed, non-refunded orders.",
        "exclusions": [
         "refunded = true"
        ],
        "filters": [
         "status = 'completed'"
        ],
        "id": "revenue_net",
        "measure": "sum(amount)",
        "time_column": "order_ts",
        "value_type": "numeric"
       },
       {
        "description": "Gross revenue across all orders.",
        "id": "revenue_gross",
        "measure": "sum(amount)",
        "time_column": "order_ts",
        "value_type": "numeric"
       },
       {
        "description": "Total number of orders.",
        "id": "order_count",
        "measure": "count(*)",
        "value_type": "count"
       }
      ]
     },
     "ledgerbench_project": {
      "absent_dimensions": [
       "acquisition_channel"
      ],
      "ambiguous_terms": [
       {
        "readings": [
         "revenue_gross",
         "revenue_net"
        ],
        "term": "revenue"
       }
      ],
      "fiscal_year_start_month": 1,
      "reporting_timezone": "America/New_York"
     }
    }
